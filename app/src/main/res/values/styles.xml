<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nova" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#84DCFF</item>
        <item name="android:colorPrimary">#070D19</item>
        <item name="android:windowBackground">@color/nova_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Ocupa a área do recorte da câmera frontal; o layout respeita as margens seguras. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
